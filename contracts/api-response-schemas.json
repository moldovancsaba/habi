{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habi.invalid/contracts/api-response-schemas-v2.3.0.json",
  "title": "Habi API 2.3.0 allow-listed response DTOs",
  "$defs": {
    "AttributionView": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": [
            "player",
            "parent",
            "coach"
          ]
        }
      },
      "required": [
        "displayName",
        "role"
      ],
      "additionalProperties": false
    },
    "Continuation": {
      "type": "object",
      "properties": {
        "processId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "direction": {
          "type": "string",
          "enum": [
            "before",
            "after"
          ]
        }
      },
      "required": [
        "processId",
        "direction"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reply",
            "belongs_to",
            "derived_from",
            "closes",
            "reopens"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "kind"
      ],
      "additionalProperties": false
    },
    "RecordReadDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "playerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "diary",
            "checkin_answer",
            "observation"
          ]
        },
        "recordedBy": {
          "$ref": "#/$defs/AttributionView"
        },
        "source": {
          "$ref": "#/$defs/SourceView"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sharingClass": {
          "type": "string",
          "enum": [
            "player_direct",
            "parent_shared",
            "coach"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "playerId",
        "kind",
        "recordedBy",
        "source",
        "occurredAt",
        "submittedAt",
        "sharingClass",
        "text",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "SourceView": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "self",
            "proxy",
            "observation",
            "provider"
          ]
        },
        "respondent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttributionView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "respondent"
      ],
      "additionalProperties": false
    },
    "TimelineEventReadDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "playerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "actorRole": {
          "type": "string",
          "enum": [
            "player",
            "parent",
            "coach"
          ]
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "self",
            "proxy",
            "observation",
            "provider"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "resourceRef": {
          "$ref": "#/$defs/Ref"
        },
        "processId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "replyTo": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "relatedId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "playerId",
        "submittedAt",
        "actorRole",
        "sourceKind",
        "kind",
        "resourceRef",
        "processId",
        "replyTo",
        "relatedId"
      ],
      "additionalProperties": false
    },
    "TimelinePageReadDTO": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineEventReadDTO"
          },
          "maxItems": 50
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 200
        },
        "processes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineProcessReadDTO"
          },
          "maxItems": 50
        },
        "continuations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Continuation"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        },
        "accessRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "nodes",
        "edges",
        "processes",
        "continuations",
        "nextCursor",
        "snapshotAt",
        "accessRevision"
      ],
      "additionalProperties": false
    },
    "TimelineProcessReadDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "closedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "closedAt"
      ],
      "additionalProperties": false
    }
  }
}
