{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habi.invalid/contracts/api-response-schemas-v2.4.10.json",
  "title": "Habi API 2.4.10 allow-listed response DTOs",
  "$defs": {
    "AttributionView": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": [
            "player",
            "parent",
            "coach"
          ]
        }
      },
      "required": [
        "displayName",
        "role"
      ],
      "additionalProperties": false
    },
    "Continuation": {
      "type": "object",
      "properties": {
        "processId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "direction": {
          "type": "string",
          "enum": [
            "before",
            "after"
          ]
        }
      },
      "required": [
        "processId",
        "direction"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reply",
            "belongs_to",
            "derived_from",
            "closes",
            "reopens"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "kind"
      ],
      "additionalProperties": false
    },
    "RecordReadDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "playerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "diary",
            "checkin_answer",
            "observation"
          ]
        },
        "recordedBy": {
          "$ref": "#/$defs/AttributionView"
        },
        "source": {
          "$ref": "#/$defs/SourceView"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sharingClass": {
          "type": "string",
          "enum": [
            "player_direct",
            "parent_shared",
            "coach"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "playerId",
        "kind",
        "recordedBy",
        "source",
        "occurredAt",
        "submittedAt",
        "sharingClass",
        "text",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "span": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "revision",
        "span"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "SourceView": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "self",
            "proxy",
            "observation",
            "provider"
          ]
        },
        "respondent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttributionView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "respondent"
      ],
      "additionalProperties": false
    },
    "TimelineEventReadDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "playerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "actorRole": {
          "type": "string",
          "enum": [
            "player",
            "parent",
            "coach"
          ]
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "self",
            "proxy",
            "observation",
            "provider"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "resourceRef": {
          "$ref": "#/$defs/Ref"
        },
        "processId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "replyTo": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "relatedId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "playerId",
        "submittedAt",
        "actorRole",
        "sourceKind",
        "kind",
        "resourceRef",
        "processId",
        "replyTo",
        "relatedId"
      ],
      "additionalProperties": false
    },
    "TimelinePageReadDTO": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineEventReadDTO"
          },
          "maxItems": 50
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 200
        },
        "processes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineProcessReadDTO"
          },
          "maxItems": 50
        },
        "continuations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Continuation"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        },
        "accessRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "nodes",
        "edges",
        "processes",
        "continuations",
        "nextCursor",
        "snapshotAt",
        "accessRevision"
      ],
      "additionalProperties": false
    },
    "TimelineProcessReadDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "closedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "closedAt"
      ],
      "additionalProperties": false
    },
    "CoachMaterialReadDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "playerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "materialId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "withdrawn"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "createdBy": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 20
        },
        "supersedesRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "playerId",
        "materialId",
        "version",
        "status",
        "title",
        "text",
        "createdBy",
        "sourceRefs",
        "supersedesRef"
      ],
      "additionalProperties": false
    },
    "ReportReadDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "playerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "providerVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "restricted",
            "deleted"
          ]
        },
        "latestExtractionRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "publicationRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "scanStatus": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "playerId",
        "providerVersion",
        "status",
        "scanStatus",
        "latestExtractionRef",
        "publicationRef"
      ],
      "additionalProperties": false
    },
    "UploadReadDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "playerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "staged",
            "quarantined",
            "ready",
            "aborted",
            "expired"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scanStatus": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "scannerVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "revision",
        "playerId",
        "status",
        "size",
        "sha256",
        "scanStatus",
        "scannerVersion",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  }
}
