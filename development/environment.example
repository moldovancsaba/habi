# Tervezett konfigurációs szerződés. Ez a fájl nem igazolja a szolgáltatások beállítását.
# Cloud API. Production/test requires all cloud secrets to be supplied out of band.
HG_APP_ORIGIN=
HG_ENVIRONMENT=
HG_ATLAS_URI=
HG_ATLAS_DATABASE=
HG_SSO_ISSUER=
HG_SSO_CLIENT_ID=
HG_SSO_CLIENT_SECRET=
HG_SSO_REDIRECT_URI=
HG_SESSION_HMAC_KEY=
HG_REFRESH_ENCRYPTION_KEY=
HG_CURSOR_HMAC_KEY=
HG_EXTERNAL_ENABLED=false
HG_SYNTHETIC_DATA_ONLY=true
# External provider is separately disabled until its policy and budget are approved.
HG_EXTERNAL_PROJECT=
HG_EXTERNAL_MODEL=
HG_EXTERNAL_API_KEY=
# Mac worker only. Never copy cloud database/session credentials to the Mac.
HG_WORKER_MODE=local_synthetic
# For worker runs, use worker/.env.example; this combined template contains blank cloud keys.
HG_CLOUD_API_ORIGIN=
HG_WORKER_CLIENT_ID=
HG_WORKER_CLIENT_SECRET=
HG_WORKER_SSO_TOKEN_ENDPOINT=
HG_HOST_LOCK_PATH=
HG_OLLAMA_ORIGIN=
HG_MODEL=qwen2.5:7b
# Fill only from verified runtime-manifest.json and the controlled prompt release.
HG_MODEL_DIGEST=sha256:845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e
HG_PROMPT_HASH=f330e95d9312d0ade1e19305bd75cf9c74cb5cf35916a8be94f14def285aa7d7
