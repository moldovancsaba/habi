# Tervezett konfigurációs szerződés. Ez a fájl nem igazolja a szolgáltatások beállítását.
# Cloud API. Production/test requires all cloud secrets to be supplied out of band.
HG_APP_ORIGIN=
HG_LEGACY_APP_ORIGIN=
HG_ENVIRONMENT=
# Hosted one-browser MVP, intentionally separate from the later SSO role workflow.
HG_MVP_MODE=
HG_ATLAS_URI=
HG_ATLAS_DATABASE=
HG_SSO_ISSUER=
HG_SSO_CLIENT_ID=
HG_SSO_CLIENT_SECRET=
HG_SSO_REDIRECT_URI=
HG_SESSION_HMAC_KEY=
HG_REFRESH_ENCRYPTION_KEY=
HG_CURSOR_HMAC_KEY=
HG_WORKER_SERVICE_ID=
# SHA-256 of a generated 256-bit worker bearer token; raw token stays on the Mac.
HG_WORKER_BEARER_SHA256=
HG_EXTERNAL_ENABLED=false
HG_SYNTHETIC_DATA_ONLY=true
# External provider is separately disabled until its policy and budget are approved.
HG_EXTERNAL_PROJECT=
HG_EXTERNAL_MODEL=
HG_EXTERNAL_API_KEY=
# Mac worker only. Never copy cloud database/session credentials to the Mac.
HG_WORKER_MODE=local_synthetic
# For worker runs, use worker/.env.example; this combined template contains blank cloud keys.
HG_CLOUD_API_ORIGIN=
HG_WORKER_SERVICE_ID=
# Raw token belongs only on the Mac worker; Vercel receives its SHA-256 hash.
HG_WORKER_BEARER_TOKEN=
HG_WORKER_BEARER_SHA256=
HG_HOST_LOCK_PATH=
HG_OLLAMA_ORIGIN=
HG_MODEL=qwen2.5:7b
# Hosted-only Hetzner service key belongs on the Mac worker, never in Vercel or browser bundles.
HG_SHARED_AI_BASE_URL=https://chatbotapi.haho.ai/v1
HG_SHARED_AI_API_KEY=
HG_SHARED_AI_MODEL=auto
# Fill only from verified runtime-manifest.json and the controlled prompt release.
HG_MODEL_DIGEST=sha256:845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e
HG_PROMPT_HASH=36c0b2d792c6f8c8e865e37508643827b661931f4a1e96abcb4185b3c70d550e
